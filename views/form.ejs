<%- include('head') %><p class="eyebrow">PRODUCT MASTER</p><h1><%= p.id?fmId(p.id)+' を編集':'商品を登録' %></h1><p>タイトルだけで保存できます。説明文やタグは後から追加できます。</p><% if(error){ %><p role="alert" class="error"><%= error %></p><% } %>
<form class="panel editor" method="post" action="<%= p.id?'/products/'+p.id:'/products' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>商品タイトル <small>必須</small><input name="master_title" required maxlength="1000" value="<%= p.master_title %>"></label><label>説明文<textarea name="master_description" rows="9"><%= p.master_description %></textarea></label><label>ハッシュタグ（そのままコピーする文章）<textarea name="hashtags_text" rows="3"><%= p.hashtags_text %></textarea></label><div class="grid"><label>管理カテゴリ<select name="category_id"><option value="">未設定</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(p.category_id)===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>整理状態<select name="organization_status"><% ['unorganized','ready'].forEach(s=>{ %><option value="<%= s %>" <%= p.organization_status===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></label><label>商品管理状態<select name="lifecycle_status"><% ['active','sold','withdrawn'].forEach(s=>{ %><option value="<%= s %>" <%= p.lifecycle_status===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></label></div><div class="actions"><button>保存する</button><a href="<%= p.id?'/products/'+p.id:'/products' %>">キャンセル</a></div></form><%- include('foot') %>