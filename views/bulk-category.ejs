<%- include('head') %><h1>カテゴリ一括変更の確認</h1><p><strong><%= products.length %>件</strong>を「<strong><%= category.name %></strong>」に変更します。</p><p>変更するのは管理カテゴリだけです。</p><form method="post" action="/products/bulk-category/confirm"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="category_id" value="<%= category.id %>"><input type="hidden" name="return_query" value="<%= returnQuery %>"><div class="actions"><button>この内容で確定</button><a href="/products?<%= returnQuery %>">キャンセル</a></div><ul><% products.forEach(p=>{ %><li><input type="hidden" name="product_ids" value="<%= p.id %>"><%= fmId(p.id) %>：<%= p.master_title %>（<%= categories.find(c=>c.id===p.category_id)?.name||'未設定' %> → <%= category.name %>）</li><% }) %></ul></form><%- include('foot') %>