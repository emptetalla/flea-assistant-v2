<%- include('head') %><h1>DBバックアップ</h1><p>対象はV2のSQLite DBのみです。写真・インポートファイルは含みません。</p><% if(message){ %><p role="status"><%= message %></p><% } %><form method="post" action="/backups/create"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>今すぐバックアップ</button></form><div class="table-wrap"><table><thead><tr><th>作成日時</th><th>products</th><th>listings</th><th>ファイル名</th><th>復元</th></tr></thead><tbody><% files.forEach(f=>{ %><tr><td><%= f.createdAt?new Date(f.createdAt).toLocaleString('ja-JP',{timeZone:'Asia/Tokyo'}):'—' %></td><td><%= f.products??'—' %></td><td><%= f.listings??'—' %></td><td><%= f.name %><% if(f.error){ %><p class="error"><%= f.error %></p><% } %></td><td><% if(!f.error){ %><form method="post" action="/backups/preview"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="filename" value="<%= f.name %>"><button class="secondary">このバックアップに戻す</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('foot') %>