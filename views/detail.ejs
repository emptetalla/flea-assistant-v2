<%- include('head') %><div class="heading"><div><p class="eyebrow"><%= fmId(p.id) %></p><h1><%= p.master_title %></h1><p><%= p.category_name||'カテゴリ未設定' %> · <%= labels[p.organization_status] %> · <%= labels[p.lifecycle_status] %></p></div><a class="button" href="/products/<%= p.id %>/edit">編集する</a></div>
<section class="panel"><div class="heading"><h2>出品用の原稿</h2><button type="button" data-copy-all>全部コピー</button></div><% [['title','タイトル',p.master_title],['description','説明文',p.master_description],['hashtags','ハッシュタグ',p.hashtags_text]].forEach(([key,label,value])=>{ %><div class="copy-block"><div class="heading"><h3><%= label %></h3><button class="secondary" type="button" data-copy="<%= key %>" <%= value?'':'disabled' %>>コピー</button></div><textarea readonly id="copy-<%= key %>" aria-label="<%= label %>" rows="<%= key==='description'?7:2 %>"><%= value %></textarea></div><% }) %><p id="copy-message" role="status" aria-live="polite"></p></section>
<h2>サイト別の出品履歴</h2><div class="sites"><% Object.entries(siteLabels).forEach(([site,name])=>{const items=listings.filter(l=>l.site===site); %><section class="panel"><h3><%= name %></h3><p><%= items.some(l=>l.status==='active')?'出品中あり':'現在出品なし' %> · 履歴 <%= items.length %> 件</p><% if(!items.length){ %><p class="muted">まだ出品情報がありません</p><% } %><% items.forEach(l=>{ %><article class="listing"><strong><%= l.status==='active'?'出品中':labels[l.status] %></strong><p><%= l.site_title %></p><p class="muted">出品ID: <%= l.site_item_id %> / 内部ID: <%= l.id %></p><p><%= l.price===null?'価格未設定':'¥'+l.price.toLocaleString('ja-JP') %></p><p class="muted">出品: <%= l.listed_at||'不明' %><br>終了: <%= l.ended_at||'未記録' %></p></article><% }) %></section><% }) %></div>
<% if(legacy.length){ %><section class="panel"><h2>旧アプリのID（V2とは別の番号）</h2><% legacy.forEach(l=>{ %><p><%= l.source_system %>: 旧FM<%= l.legacy_product_id %></p><% }) %></section><% } %><p class="muted">作成 <%= p.created_at %> / 更新 <%= p.updated_at %></p><%- include('foot') %>