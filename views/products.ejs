<%- include('head') %><div class="heading"><div><p class="eyebrow">PRODUCT MASTER</p><h1>商品一覧</h1><p>未整理のものも、タイトルだけで登録できます。</p></div><a class="button" href="/products/new">＋ 商品を登録</a></div>
<form class="filters product-filters" method="get"><input type="hidden" name="sort" value="<%= f.sort %>"><label>検索<input name="q" value="<%= f.q %>" placeholder="タイトル / FM-ID"></label><label>整理状態<select name="organization"><option value="">すべて</option><% ['unorganized','ready'].forEach(s=>{ %><option value="<%= s %>" <%= f.organization===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></label><label>商品管理状態<select name="lifecycle"><option value="">すべて</option><% ['active','sold','withdrawn'].forEach(s=>{ %><option value="<%= s %>" <%= f.lifecycle===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></label><label>管理カテゴリ<select name="category"><option value="">すべて</option><option value="unset" <%= f.category==='unset'?'selected':'' %>>カテゴリ未設定</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= f.category===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><% Object.entries(siteLabels).forEach(([site,name])=>{ %><label><%= name %><select name="<%= site %>"><option value="">すべて</option><% Object.entries(stateLabels).forEach(([state,label])=>{ %><option value="<%= state %>" <%= f[site]===state?'selected':'' %>><%= label %></option><% }) %></select></label><% }) %><label class="candidate-toggle"><input type="checkbox" name="candidate_only" value="1" <%= f.candidate_only?'checked':'' %>>カテゴリ候補ありのみ</label><button>絞り込む</button></form>
<% if(updated!==null){ %><p role="status"><%= updated %>件のカテゴリを変更しました。</p><% } %>
<form method="post" action="/products/bulk-category" id="bulk-category"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_query" value="<%= returnQuery %>">
<div class="selection-tools"><button type="button" data-select-all>現在表示中を全選択</button><button type="button" class="secondary" data-clear-all>全選択解除</button></div><div class="bulk-dock" id="bulk-dock" hidden><span role="status" id="selected-count">0件選択</span><label>変更先カテゴリ<select name="category_id" required><option value="">選択してください</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><button>カテゴリを一括変更</button></div>
<p class="muted">次の画面で対象商品と変更先を確認してから確定します。候補はタイトル先頭の [カテゴリ名] / 【カテゴリ名】が完全一致したものです。自動では変更しません。</p>
<p><strong><%= products.length %></strong> 商品</p><div class="table-wrap compact-products" tabindex="0" aria-label="商品一覧（全件表示）"><table><colgroup><col class="col-check"><col class="col-id"><col class="col-title"><col class="col-category"><col class="col-category"><col class="col-status"><col class="col-status"><col class="col-site"><col class="col-site"><col class="col-site"></colgroup><thead><tr><th>選択</th><th>FM-ID</th><th>商品タイトル</th><th>カテゴリ</th><th aria-sort="<%= f.sort==='candidate_asc'?'ascending':f.sort==='candidate_desc'?'descending':'none' %>">カテゴリ候補 <a href="<%= sortQuery('asc') %>" aria-label="カテゴリ候補 昇順" title="昇順（候補なしは末尾）">↑</a> <a href="<%= sortQuery('desc') %>" aria-label="カテゴリ候補 降順" title="降順（候補なしは先頭）">↓</a></th><th>整理</th><th>商品管理状態</th><% Object.values(siteLabels).forEach(name=>{ %><th><%= name %></th><% }) %></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><input type="checkbox" name="product_ids" value="<%= p.id %>" aria-label="<%= fmId(p.id) %> を選択"></td><td><a href="/products/<%= p.id %>"><%= fmId(p.id) %></a></td><td><a class="product-title" title="<%= p.master_title %>" href="/products/<%= p.id %>"><%= p.master_title %></a></td><td><%= p.category_name||'未設定' %></td><td><%= categoryCandidate(p.master_title,categories)?.name||'—' %></td><td><span class="badge"><%= labels[p.organization_status] %></span></td><td><span class="badge"><%= labels[p.lifecycle_status] %></span></td><% Object.keys(siteLabels).forEach(site=>{ %><td><span class="badge state-<%= p[site+'_state'] %>"><%= stateLabels[p[site+'_state']] %></span></td><% }) %></tr><% }) %></tbody></table></div><% if(!products.length){ %><div class="empty">該当商品はありません。新規登録またはMercari CSVのインポートから始めましょう。</div><% } %></form><script src="/bulk-category.js" defer></script><script src="/list-position.js" defer></script><%- include('foot') %>