<%- include('head') %><div class="heading"><div><p class="eyebrow">PRODUCT MASTER</p><h1>商品一覧</h1><p>未整理のものも、タイトルだけで登録できます。</p></div><a class="button" href="/products/new">＋ 商品を登録</a></div>
<form class="filters" method="get"><label>検索<input name="q" value="<%= f.q %>" placeholder="タイトル / FM-ID"></label><label>整理状態<select name="organization"><option value="">すべて</option><% ['unorganized','ready'].forEach(s=>{ %><option value="<%= s %>" <%= f.organization===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></label><label>販売状態<select name="lifecycle"><option value="">すべて</option><% ['active','sold','withdrawn'].forEach(s=>{ %><option value="<%= s %>" <%= f.lifecycle===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></label><label>管理カテゴリ<select name="category"><option value="">すべて</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= f.category===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>現在出品なし<select name="missing"><option value="">指定なし</option><% Object.entries(siteLabels).forEach(([s,name])=>{ %><option value="<%= s %>" <%= f.missing===s?'selected':'' %>><%= name %></option><% }) %></select></label><button>絞り込む</button></form>
<p><strong><%= products.length %></strong> 商品</p><div class="table-wrap"><table><thead><tr><th>FM-ID</th><th>商品タイトル</th><th>カテゴリ</th><th>整理</th><th>販売</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><a href="/products/<%= p.id %>"><%= fmId(p.id) %></a></td><td><a href="/products/<%= p.id %>"><%= p.master_title %></a></td><td><%= p.category_name||'未設定' %></td><td><span class="badge"><%= labels[p.organization_status] %></span></td><td><%= labels[p.lifecycle_status] %></td></tr><% }) %></tbody></table></div><% if(!products.length){ %><div class="empty">該当商品はありません。新規登録またはMercari CSVのインポートから始めましょう。</div><% } %><%- include('foot') %>